#!/usr/bin/env bash
# push の前に CI の Lint と同じ確認（scripts/check.sh）を回す。scripts/setup.sh が git config core.hooksPath .githooks で登録する。
# 2026-10-20〜28 の Lint の失敗5件は、どれも push の前に scripts/check.sh を回していれば手元で分かったもの（incidents/2026-11-03-lint-failed-after-push.md）。
# main への push・タグだけの push でも回す（ここが壊れると全リポジトリの CI が止まるため）。
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# 通ったときは1行だけ出す（AI の会話に何十行も流さない。2026-11-07 トークン節約）。全部見たいときは PREPUSH_VERBOSE=1
log="$(mktemp)"
if [ "${PREPUSH_VERBOSE:-}" = 1 ]; then bash scripts/check.sh && ok=0 || ok=$?; else bash scripts/check.sh >"$log" 2>&1 && ok=0 || ok=$?; fi
if [ "$ok" -ne 0 ]; then
  grep -v '^ INFO\|::notice::\|^✓' "$log" | tail -40 >&2
  rm -f "$log"
  echo "✗ pre-push: 確認が通らないので push を止めた。直してからもう一度 push する（全部の出力は bash scripts/check.sh。道具が無いときは bash scripts/setup.sh）" >&2
  exit 1
fi
rm -f "$log"
echo "✓ pre-push: scripts/check.sh が通った"
